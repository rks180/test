{
  "name": "insuredmine-assessment",
  "version": "1.0.0",
  "description": "InsuredMine Node.js assessment (TypeScript) - CSV/XLSX to MongoDB via worker threads, policy search & aggregation APIs, CPU monitor with auto-restart, scheduled messages",
  "main": "dist/cluster.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "start": "npm run build && node dist/cluster.js",
    "start:single": "npm run build && node dist/server.js",
    "dev": "tsc-watch --onSuccess \"node dist/server.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "bash scripts/smoke-test.sh"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "mongodb",
    "mongoose",
    "worker-threads",
    "node-cron"
  ],
  "author": "Ravi Shankar Kumar",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
